# Call transcriber configuration
# Edit these values to tune how calls are classified for Telegram.

# --- Classification keywords -------------------------------------------------
# Lowercase words/phrases that suggest a WORK call (match inside transcript).
WORK_KEYWORDS="invoice payment pay client project deadline report meeting milestone contract vendor quotation order deliverable salary business work appointment office call vendor delivery sir madam market rate price bill"

# Lowercase words/phrases that suggest a PERSONAL call.
PERSONAL_KEYWORDS="dinner lunch breakfast food shopping market birthday picnic family home mummy mom papa dad wifey wife husband girlfriend boyfriend weekend party chai khana ghar mela sajawat health medical doctor"

# --- Optional contact-name overrides (case-insensitive regex) ----------------
# Matched against the caller name from the filename, e.g. "Vivek Verma (Canon India)".
# Set WORK_CONTACTS to regexes of known business callers (use | to separate).
#WORK_CONTACTS="canon|infosys|client|vendor|office"
# Set PERSONAL_CONTACTS to regexes of known family/friends.
#PERSONAL_CONTACTS="wifey|mummy|papa|bhai|didi"

# --- Transcription settings ---------------------------------------------------
# Paths are auto-detected; uncomment to override.
# Whisper model: small (~6x realtime) vs large-v3-turbo (best Hindi/Marathi
# accuracy + supports the language natively; slower but the recommended
# choice for Indian call audio). Pick whichever suits your phone's battery/CPU.
WHISPER_MODEL="/opt/transcriber/whisper.cpp-master/models/ggml-large-v3-turbo.bin"
#LLM_MODEL="qwen2.5:1.5b"

# Check for new recordings every N seconds.
#POLL_SECS=60