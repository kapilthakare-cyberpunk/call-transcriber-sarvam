# Call transcriber configuration
# Edit these values to tune how calls are classified for Telegram.

# --- Classification keywords -------------------------------------------------
# Lowercase words/phrases that suggest a WORK call (match inside transcript).
WORK_KEYWORDS="invoice payment pay client project deadline report meeting milestone contract vendor quotation order deliverable salary business work appointment office call vendor delivery sir madam market rate price bill"

# Lowercase words/phrases that suggest a PERSONAL call.
PERSONAL_KEYWORDS="dinner lunch breakfast food shopping market birthday picnic family home mummy mom papa dad wifey wife husband girlfriend boyfriend weekend party chai khana ghar mela sajawat health medical doctor"

# --- Optional contact-name overrides (case-insensitive regex) ----------------
# Matched against the caller name from the filename, e.g. "Vivek Verma (Canon India)".
# Set WORK_CONTACTS to regexes of known business callers (use | to separate).
#WORK_CONTACTS="canon|infosys|client|vendor|office"
# Set PERSONAL_CONTACTS to regexes of known family/friends.
#PERSONAL_CONTACTS="wifey|mummy|papa|bhai|didi"

# --- Transcription settings ---------------------------------------------------
# Primary transcription: sarvam | whisper_local
TRANSCRIPTION_PROVIDER="${TRANSCRIPTION_PROVIDER:-sarvam}"

# Local Whisper model path/name if using whisper_local.
WHISPER_MODEL="${WHISPER_MODEL:-/opt/transcriber/whisper.cpp-master/models/ggml-large-v3-turbo.bin}"

# Poll interval for new recordings.
#POLL_SECS=60

# --- Classification / summary LLM ------------------------------------------------
# Provider options:
# local | none | openrouter | groq | cerebras | mistral | opencode_zen
SUMMARY_PROVIDER="${SUMMARY_PROVIDER:-local}"

# OpenRouter gateway example:
# SUMMARY_API_URL="https://openrouter.ai/api/v1/chat/completions"
# SUMMARY_API_KEY="..."
# SUMMARY_MODEL="meta-llama/llama-4-scout"

# Groq example:
# SUMMARY_API_URL="https://api.groq.com/openai/v1/chat/completions"
# SUMMARY_API_KEY="..."
# SUMMARY_MODEL="llama3-8b-8192"

# Cerebras example:
# SUMMARY_API_URL="https://api.cerebras.ai/v1/chat/completions"
# SUMMARY_API_KEY="..."
# SUMMARY_MODEL="llama-3.3-70b"

# Mistral example:
# SUMMARY_API_URL="https://api.mistral.ai/v1/chat/completions"
# SUMMARY_API_KEY="..."
# SUMMARY_MODEL="mistral-small-latest"

# OpenCode Zen example:
# SUMMARY_API_URL="https://zen.openode.ai/v1/chat/completions"
# SUMMARY_API_KEY="..."
# SUMMARY_MODEL="..."

# Backward compat: if SUMMARY_PROVIDER=local and LLM_MODEL is set, prefer it.
LLM_MODEL="${LLM_MODEL:-qwen2.5:1.5b}"